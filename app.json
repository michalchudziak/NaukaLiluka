{
  "expo": {
    "name": "NaukaLiluka",
    "slug": "NaukaLiluka",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/app-icon.png",
    "scheme": "naukaliluka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.michalchudziak.NaukaLiluka"
    },
    "android": {
      "icon": "./assets/images/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#2f8653"
      },
      "package": "com.michalchudziak.NaukaLiluka"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 320,
            "resizeMode": "contain",
            "backgroundColor": "#2f8653"
          },
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "tabletImage": "./assets/images/splash-tablet.png",
            "imageWidth": 380,
            "resizeMode": "contain",
            "backgroundColor": "#2f8653",
            "tabletBackgroundColor": "#2f8653"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
